{
  "name": "volej-klub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "live:check": "node --use-system-ca scripts/live-check.mjs",
    "test:live": "node --use-system-ca scripts/live-check.mjs --accounts",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write src tests docs *.ts *.json *.md",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:status": "node --use-system-ca scripts/live-migration-status.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.53.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postgres": "3.4.8",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
